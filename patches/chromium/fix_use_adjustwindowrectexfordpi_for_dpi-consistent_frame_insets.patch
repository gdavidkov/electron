From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Georgi Davidkov <gdavidkov@hotmail.com>
Date: Tue, 12 May 2026 18:09:47 +0300
Subject: fix: use AdjustWindowRectExForDpi for DPI-consistent frame insets

InflateClientSizeConstraintsInPixels computed frame border insets via
GetClientRect/GetWindowRect, which return physical pixels at the DPI the
window was last rendered at. When a window moves across monitors with
different DPI scaling (or is initially created at (0,0) on a different-DPI
monitor), these stale insets get mixed with content constraints that were
already scaled to the new monitor's DPI via DIPToScreenSize. The mismatch
inflates or deflates the minimum track size, causing:
- Height forced to 56px (Windows minimum + wrong frame) on cross-DPI drag
- Height corruption (e.g. 150 -> 100 = 150/1.5) when created on secondary

Replace with AdjustWindowRectExForDpi(..., GetDpiForWindow(hwnd)) which
computes frame borders at the same DPI that MonitorFromWindow reports,
keeping the constraint math self-consistent across DPI transitions.

This is intended to be upstreamed as a follow-up to
https://chromium-review.googlesource.com/c/chromium/src/+/7795073

diff --git a/ui/views/win/hwnd_util.cc b/ui/views/win/hwnd_util.cc
index 969fefa59648c1c45ebfec8fdc6598fdeae2a90a..153a0d4197c22bb921168a1628f4d29318c580be 100644
--- a/ui/views/win/hwnd_util.cc
+++ b/ui/views/win/hwnd_util.cc
@@ -18,7 +18,6 @@
 #include "ui/aura/window.h"
 #include "ui/aura/window_tree_host.h"
 #include "ui/base/class_property.h"
-#include "ui/gfx/win/msg_util.h"
 #include "ui/views/widget/widget.h"
 
 DEFINE_UI_CLASS_PROPERTY_TYPE(Microsoft::WRL::ComPtr<IAccessible>*)
@@ -147,13 +146,17 @@ gfx::NativeViewAccessible HWNDNativeViewAccessibleForWidget(
 void InflateClientSizeConstraintsInPixels(HWND hwnd,
                                           gfx::Size& min,
                                           gfx::Size& max) {
-  RECT client_rect;
-  RECT window_rect;
-  ::GetClientRect(hwnd, &client_rect);
-  ::GetWindowRect(hwnd, &window_rect);
-  CR_DEFLATE_RECT(&window_rect, &client_rect);
-  const gfx::Size inset = gfx::Size(window_rect.right - window_rect.left,
-                                    window_rect.bottom - window_rect.top);
+  // Use AdjustWindowRectExForDpi to compute frame insets at the DPI that
+  // matches what DIPToScreenSize uses (via GetScaleFactorForHWND ->
+  // MonitorFromWindow). The previous GetClientRect/GetWindowRect approach
+  // returned physical pixels at whatever DPI the window was last rendered at,
+  // which can differ from the current monitor's DPI during cross-monitor moves
+  // or initial window creation at (0,0).
+  RECT frame = {0, 0, 0, 0};
+  ::AdjustWindowRectExForDpi(&frame, ::GetWindowLong(hwnd, GWL_STYLE), FALSE,
+                             ::GetWindowLong(hwnd, GWL_EXSTYLE),
+                             ::GetDpiForWindow(hwnd));
+  const gfx::Size inset(frame.right - frame.left, frame.bottom - frame.top);
 
   min.Enlarge(inset.width(), inset.height());
   // zero means "no maximum" so enlarge width/height independently.
